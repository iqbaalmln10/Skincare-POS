{
  "name": "@skincare-pos/desktop",
  "version": "0.1.0",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "preview": "electron-vite preview",
    "package": "npm run build && node scripts/package.js",
    "postinstall": "electron-rebuild -f -w serialport"
  },
  "dependencies": {
    "@node-escpos/core": "^0.6.0",
    "@node-escpos/serialport-adapter": "^1.0.0",
    "@zxing/browser": "^0.1.5",
    "axios": "^1.7.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^3.9.2",
    "serialport": "^13.0.0",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.byme.app",
    "productName": "By Me",
    "npmRebuild": false,
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "../backend/dist",
        "to": "backend/dist"
      },
      {
        "from": "../backend/node_modules",
        "to": "backend/node_modules"
      },
      {
        "from": "../backend/package.json",
        "to": "backend/package.json"
      }
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "description": "Aplikasi Kasir & Manajemen Toko By Me",
  "author": "By Me"
}
